# ---------- MarkLogic ----------
ML_HOST=localhost
ML_PORT=8000
ML_DATABASE=Documents
ML_AUTH=kerberos        # kerberos (Windows login) | digest | basic
ML_SCHEME=http
ML_ID_PATH=documentId   # field holding each document's ID (fetch reads it)
ML_LINK_PATH=binaryUri,domURI   # fields in a record that point at its other documents
ML_CREATED_PATH=createdDate  # creation date/time; fetch sorts oldest first
# only for digest / basic:
ML_USER=
ML_PASSWORD=

# Where `stage` writes its per-document folders (default: output/stage)
STAGE_DIR=

# ---------- Snowflake ----------
# Needed by every Snowflake command. Names on the right are the matching keys
# in snowflake-config.properties.
SF_HOST=                # sf.datasource.server.url
SF_USER=                # sf.datasource.user.name
SF_ROLE=                # sf.datasource.role.name
SF_WAREHOUSE=           # sf.datasource.warehouse.name
SF_DATABASE=            # sf.datasource.db.name
SF_SCHEMA=              # schema holding the stage below
SF_STAGE=               # named stage `stage` uploads into, e.g. GDX_MARKLOGIC_DOCUMENTS

# ---------- Snowflake sign-in: fill in ONE of these four ----------
# 1. Key pair from the Secure Credentials Vault (what the Java service uses)
SF_NAMESPACE=           # sf.datasource.namespace.name
SF_CERT_KEY=            # sf.datasource.certkey.name
SF_PASSPHRASE_KEY=      # sf.datasource.passphrasekey.name
# 2. Key pair from a PEM file, if scvlib is not available here
SF_PRIVATE_KEY=         # path to the key file
SF_PRIVATE_KEY_PASSPHRASE=
# 3. Company SSO - a browser window opens
SF_AUTHENTICATOR=       # externalbrowser
# 4. Password
SF_PASSWORD=

# ---------- Optional ----------
SF_PROXY_HOST=          # sf.datasource.proxy.host
SF_PROXY_PORT=          # sf.datasource.proxy.port
SF_ACCOUNT=             # only if it cannot be derived from SF_HOST
SF_PORT=                # only if Snowflake is not on 443
SF_LOGIN_TIMEOUT=       # seconds, default 60
SF_SCV_MODULE=          # if the vault library imports under another name
